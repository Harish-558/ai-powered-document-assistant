<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_white"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="32dp" />

            <!-- Success Green Checkmark Icon -->
            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:contentDescription="Success"
                android:src="@drawable/ic_success_check" />

            <!-- Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="Document Uploaded!"
                android:textColor="@color/text_main"
                android:textSize="24sp"
                android:textStyle="bold" />

            <!-- Document Details Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:background="@drawable/bg_card_white"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="20dp">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="52dp"
                    android:contentDescription="PDF Icon"
                    android:src="@drawable/ic_pdf_card_icon" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvSuccessFilename"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Invoice_Oct.pdf"
                        android:textColor="@color/text_main"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSuccessFilesize"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="pdf - 2.4MB - Oct 2021"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Action Button 1: Start Chat -->
            <Button
                android:id="@+id/btnStartChat"
                style="@style/VioletButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="12dp"
                android:text="Start Chat"
                android:textAllCaps="false" />

            <!-- Action Button 2: View Details -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnViewDetails"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_outlined_dark_pill"
                android:text="View Details"
                android:textAllCaps="false"
                android:textColor="#172033"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
