<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Harish331" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Main colors -->
        <item name="colorPrimary">@color/primary_violet</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:windowBackground">@color/bg_white</item>
        <item name="android:statusBarColor">@color/bg_white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/bg_white</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Theme.Harish331" parent="Base.Theme.Harish331" />

    <!-- Custom Button Style -->
    <style name="VioletButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/primary_violet</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- Custom Outlined Button Style -->
    <style name="OutlinedVioletButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/primary_violet</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:textColor">@color/primary_violet</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
</resources>